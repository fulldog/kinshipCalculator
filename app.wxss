page {
  --bg: #F6F5F2;
  --card: #FFFFFF;
  --ink: #1F1D1A;
  --ink-2: #6B655C;
  --ink-3: #A39C90;
  --line: #E6E2DA;
  --accent: #B04A3A;
  --accent-soft: #F3E4E0;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
}

.wrap {
  padding: 28rpx 32rpx 60rpx;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.label {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.muted {
  color: var(--ink-2);
  font-size: 26rpx;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
}

.btn-primary.disabled {
  background: #D8D2C8;
  color: #fff;
}

.btn-ghost {
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}
