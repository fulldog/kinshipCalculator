@import "styles/tokens.wxss";

page,
button,
input,
textarea {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", "楷体_GB2312", system-ui, -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

page {
  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.55;
}

.wrap {
  padding: 28rpx 32rpx 60rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.label {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.muted {
  color: var(--ink-2);
  font-size: 26rpx;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius);
  text-align: center;
  font-size: 32rpx;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
}

.btn-primary.disabled {
  background: var(--disabled);
  color: #fff;
}

.btn-ghost {
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}
