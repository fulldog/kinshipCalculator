.head {
  padding: 24rpx 8rpx 40rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.head-sub {
  font-size: 26rpx;
  color: #8A8578;
  margin-top: 8rpx;
}

.h {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 14rpx;
}

.p {
  font-size: 27rpx;
  color: #6B655C;
  line-height: 1.75;
  margin-bottom: 12rpx;
}

.p:last-child {
  margin-bottom: 0;
}

.btn-feedback {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 1rpx solid #E6E2DA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1F1D1A;
  background: #F6F5F2;
}

.ver {
  text-align: center;
  font-size: 22rpx;
  color: #A39C90;
  padding: 24rpx 0 40rpx;
}
