<view class="wrap about">
  <view class="head">
    <view class="head-title">亲戚称呼计算器</view>
    <view class="head-sub">对方是谁，一句话算清楚</view>
  </view>

  <view class="card" wx:for="{{sections}}" wx:key="h">
    <view class="h-row" data-i="{{index}}" bindtap="onToggle" hover-class="h-hover">
      <view class="h">{{item.h}}</view>
      <view class="chev">{{open === index ? '收起' : '展开'}}</view>
    </view>
    <view wx:if="{{open === index}}">
      <view class="p" wx:for="{{item.paragraphs}}" wx:for-item="para" wx:key="*this">{{para}}</view>
      <view wx:if="{{item.feedback}}" class="btn-feedback" bindtap="onCopyFeedback" hover-class="btn-feedback-hover">复制反馈模板</view>
    </view>
  </view>

  <view class="ver">版本 {{version}} · 完全离线运行</view>
</view>
