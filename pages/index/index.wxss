@import "../../styles/tokens.wxss";

.home {
  padding: 12rpx 32rpx calc(168rpx + constant(safe-area-inset-bottom));
  padding: 12rpx 32rpx calc(168rpx + env(safe-area-inset-bottom));
}

.sex-block {
  padding: 8rpx 8rpx 20rpx;
}

.sex-row {
  display: flex;
  align-items: center;
}

.sex-label {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-right: 20rpx;
}

.seg {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 6rpx;
}

.seg-item {
  min-width: 112rpx;
  padding: 12rpx 28rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  text-align: center;
}

.seg-item.on {
  background: var(--accent-soft);
  color: var(--accent);
}

.sex-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.examples {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.example {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 12rpx 0;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--ink);
}

.example-hover {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.preview {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed var(--line);
}

.preview-label {
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}

.preview-value {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--accent);
  letter-spacing: 4rpx;
  line-height: 1.3;
  text-align: center;
}

.preview-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}

.preview-row .preview-value {
  flex: 0 1 auto;
  min-width: 0;
}

/* 称呼典故问号 */
.lore-icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg);
  border: 1rpx solid var(--line);
  color: var(--ink-3);
  font-size: 28rpx;
  margin-left: 12rpx;
}

.lore-hover {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}

.preview-note {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
  text-align: center;
}

.pending {
  margin-top: 24rpx;
  background: var(--pending-bg);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}

.pending-q {
  font-size: 26rpx;
  color: var(--accent-ink);
  line-height: 1.5;
}

.pending-btns {
  display: flex;
  margin-top: 16rpx;
}

.mini {
  flex: 1;
  text-align: center;
  height: var(--tap);
  line-height: var(--tap);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--ink);
  margin-right: 16rpx;
}

.mini:last-child {
  margin-right: 0;
}

.mini-hover {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.text-toggle {
  height: var(--tap);
  line-height: var(--tap);
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-2);
  margin: -8rpx 0 16rpx;
}

.text-toggle-hover {
  color: var(--accent);
}

.input-row {
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: var(--tap);
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
}

.ph {
  color: var(--placeholder);
}

.parse-btn {
  flex: none;
  margin-left: 16rpx;
  height: var(--tap);
  line-height: var(--tap);
  padding: 0 32rpx;
  border-radius: var(--radius-sm);
  background: var(--ink);
  color: var(--card);
  font-size: 28rpx;
}

.parse-hover {
  opacity: 0.85;
}

.warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--accent);
  line-height: 1.55;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--line);
}

.home-input {
  padding-bottom: 32rpx;
}

.dock-flow {
  position: static;
}

.go {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: var(--accent);
  color: var(--card);
  border-radius: var(--radius);
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.go.disabled {
  background: var(--disabled);
}

.go-hover {
  opacity: 0.9;
}

.reset {
  flex: none;
  margin-left: 20rpx;
  width: 152rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  font-size: 30rpx;
  color: var(--ink-2);
}

.reset-hover {
  background: var(--bg);
}

.recent-list {
  display: flex;
  flex-wrap: wrap;
}

.recent-item {
  display: flex;
  align-items: baseline;
  padding: 16rpx 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  margin: 0 16rpx 16rpx 0;
}

.recent-hover {
  background: var(--bg);
}

.recent-text {
  font-size: 28rpx;
  color: var(--ink);
  margin-right: 10rpx;
}

.recent-chain {
  font-size: 22rpx;
  color: var(--ink-3);
}

.foot {
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 16rpx 0 8rpx;
}
