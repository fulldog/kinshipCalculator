<view class="home {{inputFocused ? 'home-input' : ''}}">
  <view class="sex-block">
    <view class="sex-row">
      <text class="sex-label">我是</text>
      <view class="seg">
        <view class="seg-item {{selfSex === 'm' ? 'on' : ''}}" data-v="m" bindtap="onSex" hover-class="seg-hover">男生</view>
        <view class="seg-item {{selfSex === 'f' ? 'on' : ''}}" data-v="f" bindtap="onSex" hover-class="seg-hover">女生</view>
      </view>
    </view>
    <text class="sex-hint">影响对方怎么叫你</text>
  </view>

  <view class="card">
    <chain-editor
      chips="{{chips}}"
      bind:remove="onRemove"
      bind:undo="onUndo"
      bind:clear="onClear"
    >
      <view slot="empty" class="empty-slot">
        <view class="empty-hint">点下面的按钮，一步步选出他是谁</view>
        <view class="examples">
          <view class="example" data-text="爸爸的哥哥" bindtap="onExample" hover-class="example-hover">爸爸的哥哥</view>
          <view class="example" data-text="妈妈的弟弟" bindtap="onExample" hover-class="example-hover">妈妈的弟弟</view>
        </view>
      </view>
    </chain-editor>

    <view class="preview" wx:if="{{preview}}">
      <view class="preview-label">现在算出来是</view>
      <view class="preview-row" bindtap="onLore">
        <view class="preview-value">{{preview}}</view>
        <view class="lore-icon" wx:if="{{previewLore}}" hover-class="lore-hover">?</view>
      </view>
      <view class="preview-note" wx:if="{{previewNote}}">（{{previewNote}}）</view>
    </view>

    <view class="pending" wx:if="{{pending}}">
      <view class="pending-q">{{pendingQuestion}}</view>
      <view class="pending-btns">
        <view class="mini" data-sen="elder" bindtap="onPending" hover-class="mini-hover">年长的那个</view>
        <view class="mini" data-sen="younger" bindtap="onPending" hover-class="mini-hover">年幼的那个</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="label">再往上选一级</view>
    <rel-keypad disabled="{{keyDisabled}}" locked="{{hasPending}}" bind:pick="onPick" />
    <view class="warn" wx:if="{{warn && warnSource === 'key'}}">{{warn}}</view>
  </view>

  <view class="text-toggle" bindtap="onToggleInput" hover-class="text-toggle-hover">{{inputOpen ? '收起打字' : '直接打字'}}</view>
  <view class="card" wx:if="{{inputOpen}}">
    <view class="input-row">
      <input
        class="input"
        value="{{inputValue}}"
        placeholder="例如：爸爸的哥哥的妻子"
        placeholder-class="ph"
        bindinput="onInput"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        confirm-type="search"
        bindconfirm="onParse"
        cursor-spacing="24"
      />
      <view class="parse-btn" bindtap="onParse" hover-class="parse-hover">解析</view>
    </view>
    <view class="warn" wx:if="{{warn && warnSource === 'input'}}">{{warn}}</view>
  </view>

  <view class="recent" wx:if="{{recent.length}}">
    <view class="label">最近查过</view>
    <view class="recent-list">
      <view
        class="recent-item"
        wx:for="{{recent}}"
        wx:key="query"
        data-query="{{item.query}}"
        bindtap="onRecent"
        hover-class="recent-hover"
      >
        <text class="recent-text">{{item.text}}</text>
        <text class="recent-chain">{{item.chain}}</text>
      </view>
    </view>
  </view>

  <view class="foot" bindtap="onAbout">关于 · 称呼有误？反馈一下</view>
</view>

<view class="dock {{inputFocused ? 'dock-flow' : ''}}">
  <view
    class="go {{chips.length && !invalid ? '' : 'disabled'}}"
    bindtap="onGo"
    hover-class="{{chips.length && !invalid ? 'go-hover' : 'none'}}"
  >查看称呼</view>
  <view class="reset" bindtap="onReset" hover-class="reset-hover">重置</view>
</view>

<lore-modal
  visible="{{loreOpen}}"
  title="{{loreTitle}}"
  text="{{loreText}}"
  bind:close="onLoreClose"
/>
