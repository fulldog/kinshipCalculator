<view class="wrap result">
  <view class="top">
    <view class="tier" wx:if="{{tierLabel}}">{{tierLabel}}</view>
    <view class="ask">你该叫他</view>
    <view class="main-row" bindtap="onLore">
      <view class="main {{mainLong ? 'main-long' : ''}}">{{mainText}}</view>
      <view class="lore-icon" wx:if="{{mainLore}}" hover-class="lore-hover">?</view>
    </view>
    <view class="alias" wx:if="{{aliasText}}">{{aliasText}}</view>
    <view class="note" wx:if="{{note}}">{{note}}</view>
  </view>

  <view class="age" wx:if="{{ageSwitch}}">
    <view class="age-q">他比你大还是小？</view>
    <view class="age-btns">
      <view class="age-btn {{ageHint === 'elder' ? 'on' : ''}}" data-hint="elder" bindtap="onAge" hover-class="age-hover">比我大</view>
      <view class="age-btn {{ageHint === 'younger' ? 'on' : ''}}" data-hint="younger" bindtap="onAge" hover-class="age-hover">比我小</view>
    </view>
  </view>

  <view class="options" wx:if="{{showOptions && !ageSwitch}}">
    <view class="opt" wx:for="{{options}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="card">
    <view class="label">他该叫你</view>
    <view class="rev-value {{revLong ? 'rev-long' : ''}}">{{reverseText}}</view>
    <view class="rev-hint">{{reverseHint}}</view>
  </view>

  <view class="card">
    <view class="label">关系路径</view>
    <view class="chain">{{chainText}}</view>

    <view class="path-block">
      <view class="path-cap">你的视角</view>
      <path-graph items="{{forwardPath}}" />
    </view>

    <view class="path-block">
      <view class="path-cap">他的视角</view>
      <path-graph items="{{reversePath}}" />
    </view>
  </view>

  <view class="acts">
    <view class="act" bindtap="onCopy" hover-class="act-hover">复制</view>
    <button class="act act-share" open-type="share" hover-class="act-hover">分享给家人</button>
    <view class="act act-primary" bindtap="onAgain" hover-class="act-primary-hover">再查一个</view>
  </view>

  <ad-slot unit-id="{{adBanner}}" />
</view>

<lore-modal
  visible="{{loreOpen}}"
  title="{{loreTitle}}"
  text="{{loreText}}"
  bind:close="onLoreClose"
/>
