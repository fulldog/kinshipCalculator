@import "../../styles/tokens.wxss";

.result {
  padding: 28rpx 32rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.top {
  padding: 36rpx 8rpx 32rpx;
  text-align: center;
}

.ask {
  font-size: 26rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
}

.main {
  font-size: 104rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
  line-height: 1.25;
  margin-top: 8rpx;
}

.main-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.main-row .main {
  flex: 0 1 auto;
  min-width: 0;
  text-align: center;
}

/* 称呼典故问号 */
.lore-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg);
  border: 1rpx solid var(--line);
  color: var(--ink-3);
  font-size: 32rpx;
  margin-left: 20rpx;
}

.lore-hover {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}

.main-long {
  font-size: 44rpx;
  letter-spacing: 0;
  line-height: 1.45;
  font-weight: 500;
}

.alias {
  font-size: 28rpx;
  color: var(--accent-ink);
  margin-top: 8rpx;
}

.note {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.6;
}

.tier {
  display: inline-block;
  font-size: 22rpx;
  color: var(--accent-ink);
  background: var(--accent-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.age {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.age-q {
  font-size: 26rpx;
  color: var(--ink-2);
}

.age-btns {
  display: flex;
  margin-top: 18rpx;
}

.age-btn {
  flex: 1;
  height: var(--tap);
  line-height: var(--tap);
  text-align: center;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
  margin-right: 16rpx;
}

.age-btn:last-child {
  margin-right: 0;
}

.age-btn.on {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--card);
}

.age-hover {
  background: var(--accent-soft);
}

.options {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.opt {
  padding: 14rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--ink);
  margin: 0 16rpx 16rpx 0;
}

.rev-value {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--accent);
  margin-top: 4rpx;
  line-height: 1.35;
}

.rev-long {
  font-size: 32rpx;
  letter-spacing: 0;
  line-height: 1.45;
}

.rev-hint {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.chain {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.path-block {
  margin-bottom: 20rpx;
}

.path-cap {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.acts {
  display: flex;
  align-items: center;
  margin: 8rpx -10rpx 16rpx;
}

.act-slot {
  flex: 1;
  width: 0;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.act {
  display: block;
  width: 100% !important;
  height: 76rpx !important;
  min-height: 0 !important;
  line-height: 74rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  text-align: center;
  font-size: 28rpx !important;
  font-weight: 400;
  color: var(--ink);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx !important;
  box-sizing: border-box;
}

.act::after {
  display: none !important;
  border: 0 !important;
  content: none !important;
}

.act-hover {
  background: var(--bg);
}

.act-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--card);
}

.act-primary-hover {
  opacity: 0.92;
}
