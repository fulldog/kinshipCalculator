.editor {
  min-height: 100rpx;
}

.empty {
  font-size: 26rpx;
  color: #A39C90;
  line-height: 100rpx;
}

.chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 8rpx 0;
}

.arrow {
  color: #C9C3B8;
  font-size: 28rpx;
  margin: 0 8rpx;
}

.chip {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #F3E4E0;
  color: #8C3A2C;
  font-size: 28rpx;
  margin: 6rpx 0;
}

.chip.start {
  background: #EDEAE3;
  color: #6B655C;
}

.chip-hover {
  background: #EBD3CD;
}

.chip-x {
  font-size: 20rpx;
  color: #B98C83;
  margin-left: 10rpx;
}

.tools {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.tool {
  font-size: 24rpx;
  color: #8A8578;
  padding: 4rpx 8rpx;
}

.tool-sep {
  font-size: 20rpx;
  color: #D8D2C8;
  margin: 0 12rpx;
}
