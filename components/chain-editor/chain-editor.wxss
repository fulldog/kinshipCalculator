@import "../../styles/tokens.wxss";

.editor {
  min-height: 88rpx;
}

.empty {
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.6;
  padding: 16rpx 0;
}

.chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.chip {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 64rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
}

.chip.start {
  color: var(--ink-2);
}

.chip-hover {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.arrow {
  position: absolute;
  left: -12rpx;
  top: 0;
  width: 12rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  pointer-events: none;
}

.chip-x {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.tools {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.tool {
  min-height: var(--tap);
  line-height: var(--tap);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.tool-hover {
  color: var(--accent);
}

.tool-sep {
  font-size: 20rpx;
  color: var(--disabled);
  margin: 0 4rpx;
}
