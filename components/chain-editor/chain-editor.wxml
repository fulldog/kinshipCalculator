<view class="editor">
  <view class="empty" wx:if="{{chips.length === 0}}">点下面的按钮，一步步选出他是谁</view>

  <view class="chain" wx:else>
    <view class="chip start">你</view>
    <block wx:for="{{chips}}" wx:key="id">
      <view class="arrow">›</view>
      <view class="chip" data-index="{{index}}" bindtap="onRemove" hover-class="chip-hover">
        <text class="chip-name">{{item.name}}</text>
        <text class="chip-x">✕</text>
      </view>
    </block>
  </view>

  <view class="tools" wx:if="{{chips.length > 0}}">
    <view class="tool" bindtap="onUndo">删一步</view>
    <view class="tool-sep">|</view>
    <view class="tool" bindtap="onClear">清空</view>
  </view>
</view>
