@import "../../styles/tokens.wxss";

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  background: rgba(31, 29, 26, 0.45);
  box-sizing: border-box;
}

.sheet {
  width: 100%;
  background: var(--card);
  border-radius: 20rpx;
  padding: 40rpx 36rpx 0;
  box-sizing: border-box;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", "楷体_GB2312", system-ui, -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--ink);
}

.title,
.body,
.ok {
  font-family: inherit;
}

.title {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.45;
  text-align: center;
}

.body {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.75;
  color: var(--ink-2);
}

.ok {
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--accent);
  border-top: 1rpx solid var(--line);
}

.ok-hover {
  opacity: 0.7;
}
