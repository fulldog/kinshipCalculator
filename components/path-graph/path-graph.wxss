@import "../../styles/tokens.wxss";

.scroller {
  width: 100%;
  white-space: nowrap;
}

.track {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 0;
}

.node {
  box-sizing: border-box;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
}

.node.start {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--card);
}

.link {
  flex: none;
  align-self: center;
  width: 28rpx;
  height: 2rpx;
  background: var(--disabled);
  margin: 0 12rpx;
}
