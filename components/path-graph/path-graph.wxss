.scroller {
  width: 100%;
  white-space: nowrap;
}

.track {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 0;
}

.node {
  flex: none;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #F6F5F2;
  border: 1rpx solid #E6E2DA;
  font-size: 26rpx;
  color: #1F1D1A;
}

.node.start {
  background: #1F1D1A;
  border-color: #1F1D1A;
  color: #FFFFFF;
}

.link {
  flex: none;
  width: 32rpx;
  height: 1rpx;
  background: #D8D2C8;
  margin: 0 6rpx;
}
