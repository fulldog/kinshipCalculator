@import "../../styles/tokens.wxss";

.scroller {
  width: 100%;
  white-space: nowrap;
}

.track {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 0;
}

.stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.node {
  flex: none;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink);
}

.node.start {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--card);
}

.link {
  flex: none;
  width: 32rpx;
  height: 1rpx;
  background: var(--disabled);
  margin: 0 6rpx;
}

.vlink {
  width: 1rpx;
  height: 28rpx;
  margin-left: 40rpx;
  background: var(--disabled);
}
