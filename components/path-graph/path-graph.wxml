<view wx:if="{{items.length > 4}}" class="stack">
  <block wx:for="{{items}}" wx:key="id">
    <view class="node {{index === 0 ? 'start' : ''}}">{{item.label}}</view>
    <view class="vlink" wx:if="{{index < items.length - 1}}"></view>
  </block>
</view>

<scroll-view wx:else class="scroller" scroll-x enhanced show-scrollbar="{{false}}">
  <view class="track">
    <block wx:for="{{items}}" wx:key="id">
      <view class="node {{index === 0 ? 'start' : ''}}">{{item.label}}</view>
      <view class="link" wx:if="{{index < items.length - 1}}"></view>
    </block>
  </view>
</scroll-view>
