@import "../../styles/tokens.wxss";

.pad {
  display: block;
}

.pad.is-locked {
  opacity: 0.38;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0 0;
}

.row-label {
  width: 72rpx;
  flex: none;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 64rpx;
}

.keys {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.key {
  box-sizing: border-box;
  width: calc(25% - 12rpx);
  height: 64rpx;
  line-height: 64rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0;
  text-align: center;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.key-hover {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.key-off {
  background: var(--key-off-bg);
  border-color: var(--line);
  color: var(--disabled-ink);
}
